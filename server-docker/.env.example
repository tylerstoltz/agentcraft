# Copy to .env and edit. Everything here is optional.
MC_PORT=25565
# Foreman port on the host (tools/launch.sh --port)
AGENTCRAFT_PORT=7878
# Comma-separated player names: who may join, and who is op (ops drive agents and edit the HQ site)
MC_WHITELIST=
MC_OPS=

# World (only read when data/<MC_LEVEL> is created)
MC_LEVEL=AgentCraft HQ
# minecraft:flat (classic studio meadow) or minecraft:normal (real terrain)
MC_LEVEL_TYPE=minecraft:flat
MC_STRUCTURES=false
MC_SEED=
# creative (studio profile) or survival; MC_HARDCORE=true for hardcore
MC_GAMEMODE=creative
MC_DIFFICULTY=peaceful
MC_HARDCORE=false

# HQ site on real terrain: auto (default), spawn, X,Z or X,Y,Z
AGENTCRAFT_HQ_SITE=
AGENTCRAFT_HQ_SEARCH=
